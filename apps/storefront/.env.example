# ==============================================================================
# The Ecom Buddy - Storefront Environment Configuration
# ==============================================================================

# Port
PORT=3000

# Backend Commerce API
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Medusa Publishable API Key (associated with active Sales Channel)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_api_key_here

# Storefront Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Currency Configuration (India-First default)
NEXT_PUBLIC_DEFAULT_CURRENCY=INR

