# ==============================================================================
# The Ecom Buddy - Merchant Dashboard Configuration (Self-Hosted Installation)
# ==============================================================================

PORT=7001
NEXT_PUBLIC_PORT=7001

# Medusa v2 Backend URL (Server-to-Server Private Ingress)
MEDUSA_BACKEND_URL=http://localhost:9000

# Public Backend URL (Optional fallback for client browser calls)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# White-Label Merchant Branding Overrides (Optional - defaults to The Ecom Buddy)
MERCHANT_NAME="The Ecom Buddy"
MERCHANT_SHORT_NAME="TEB"
MERCHANT_TAGLINE="Self-Hosted Direct-to-Consumer Commerce"
MERCHANT_DEFAULT_CURRENCY="INR"
MERCHANT_CURRENCY_SYMBOL="₹"
MERCHANT_LOCALE="en-IN"
MERCHANT_TIMEZONE="Asia/Kolkata"
MERCHANT_SUPPORT_EMAIL="admin@theecombuddy.local"

