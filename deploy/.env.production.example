# ==============================================================================
# THE ECOM BUDDY — PRODUCTION ENVIRONMENT TEMPLATE (.env.production)
# Single-Merchant Autonomous Self-Hosted Architecture
#
# INSTRUCTIONS:
# Copy this file to .env.production and fill in all required secrets.
# Generate cryptographic secrets using: openssl rand -base64 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DOMAIN & HOSTING CONFIGURATION
# ------------------------------------------------------------------------------
# Storefront public customer domain (e.g. mystore.com or shop.brand.com)
STORE_DOMAIN=theecombuddy.com

# Merchant admin console domain (e.g. admin.theecombuddy.com)
MERCHANT_DOMAIN=admin.theecombuddy.com

# Backend Medusa API & Webhook domain (e.g. api.theecombuddy.com)
BACKEND_DOMAIN=api.theecombuddy.com

# Public URLs with protocol
STORE_URL=https://theecombuddy.com
MERCHANT_URL=https://admin.theecombuddy.com
BACKEND_PUBLIC_URL=https://api.theecombuddy.com

# Let's Encrypt / ACME admin contact email for automated SSL certificate renewal
ACME_EMAIL=ops@theecombuddy.com

# ------------------------------------------------------------------------------
# 2. POSTGRESQL 16 DATABASE
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=replace_with_strong_production_postgres_password
POSTGRES_DB=medusa_ecom_buddy
POSTGRES_PORT=5432

# Connection string used by Backend, Merchant, and Storefront
DATABASE_URL=postgres://postgres:replace_with_strong_production_postgres_password@postgres:5432/medusa_ecom_buddy

# ------------------------------------------------------------------------------
# 3. REDIS 7 DATA STORE (Rate limiting, Cart Locking, Webhook Deduplication)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 24
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_URL=redis://:replace_with_strong_redis_password@redis:6379

# ------------------------------------------------------------------------------
# 4. CRYPTOGRAPHIC SECRETS & TOKENS (FAIL-CLOSED IF COMPROMISED)
# ------------------------------------------------------------------------------
# Medusa JWT authentication token secret (min 32 chars)
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_32_char_cryptographically_secure_jwt_secret

# Session cookie encryption secret (min 32 chars)
# Generate with: openssl rand -base64 32
COOKIE_SECRET=replace_with_32_char_cryptographically_secure_cookie_secret

# Guest order HMAC token signing secret (min 32 chars)
# Generate with: openssl rand -base64 32
GUEST_ORDER_SECRET=replace_with_32_char_cryptographically_secure_guest_order_secret

# Session denylist encryption secret
SESSION_REVOCATION_SECRET=replace_with_32_char_revocation_secret

# ------------------------------------------------------------------------------
# 5. OFFLINE WHITE-LABEL PERPETUAL LICENSE
# ------------------------------------------------------------------------------
# Path to installed signed license.json manifest
LICENSE_FILE_PATH=/app/deploy/license.json

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL (RFC 5321 / 5322 SMTP)
# ------------------------------------------------------------------------------
# In production, configure authenticated SMTP (SendGrid, Postmark, AWS SES, Brevo)
# If unconfigured, the system fails closed safely and writes audit logs to Redis.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_api_key_or_password
SMTP_FROM_EMAIL=orders@theecombuddy.com
SMTP_FROM_NAME="The Ecom Buddy Official Store"

# ------------------------------------------------------------------------------
# 7. PAYMENT GATEWAYS (FAIL-CLOSED UNTIL VERIFIED)
# ------------------------------------------------------------------------------
# Environment: 'sandbox' (testing) or 'live' (production)
PAYMENT_ENVIRONMENT=sandbox

# Razorpay Domestic & International (INR, USD, AED, EUR, GBP)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cashfree Domestic (INR only)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_API_VERSION=2023-08-01

# Cash on Delivery (COD) Options
# Default maximum cart value for Cash on Delivery in INR (e.g. ₹10,000)
COD_MAX_LIMIT_INR=10000

# ------------------------------------------------------------------------------
# 8. PUBLISHED THEME & ASSETS
# ------------------------------------------------------------------------------
DEFAULT_THEME_PRESET=crescendo
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
NEXT_PUBLIC_SUPPORTED_CURRENCIES=INR,USD,EUR,GBP,AED
