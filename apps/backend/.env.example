# ==============================================================================
# The Ecom Buddy - Backend Environment Configuration
# ==============================================================================

# Server Port
PORT=9000

# PostgreSQL Connection URL
# Local embedded / Docker connection:
DATABASE_URL=postgres://postgres:password@localhost:5432/medusa_ecom_buddy

# Redis Connection URL (Optional for local development; in-memory fallback is active when omitted)
# Mandatory for horizontal scaling & production worker mode
# REDIS_URL=redis://localhost:6379

# CORS Configurations
# Storefront origins allowed to query the Store API
STORE_CORS=http://localhost:3000,http://127.0.0.1:3000

# Admin dashboard origins allowed to query the Admin API
ADMIN_CORS=http://localhost:9000,http://127.0.0.1:9000,http://localhost:5173

# Authentication origins allowed to exchange session cookies & tokens
AUTH_CORS=http://localhost:9000,http://127.0.0.1:9000,http://localhost:3000,http://127.0.0.1:3000

# Cryptographic Secrets (Override in production deployments)
JWT_SECRET=supersecret_ecom_buddy_jwt_token_development_only
COOKIE_SECRET=supersecret_ecom_buddy_cookie_token_development_only

# Public Backend URL
MEDUSA_BACKEND_URL=http://localhost:9000

