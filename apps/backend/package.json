{
  "name": "@the-ecom-buddy/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Medusa v2 headless commerce engine and admin dashboard for The Ecom Buddy",
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "verify": "medusa exec ./src/scripts/verify-milestone-02b.ts",
    "setup:02c": "medusa exec ./src/scripts/setup-milestone-02c.ts",
    "verify:02c": "medusa exec ./src/scripts/verify-milestone-02c.ts",
    "setup:02d-a": "medusa exec ./src/scripts/setup-milestone-02d-a.ts",
    "verify:02d-a": "medusa exec ./src/scripts/verify-milestone-02d-a.ts",
    "setup:02d-b": "medusa exec ./src/scripts/setup-milestone-02d-b.ts",
    "verify:02d-b": "medusa exec ./src/scripts/verify-milestone-02d-b.ts",
    "db:migrate": "medusa db:migrate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.22.1",
    "@medusajs/cli": "2.22.1",
    "@medusajs/framework": "2.22.1",
    "@medusajs/medusa": "2.22.1",
    "@the-ecom-buddy/types": "*"
  },
  "devDependencies": {
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
