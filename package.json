{
  "name": "the-ecom-buddy",
  "version": "1.0.0",
  "private": true,
  "description": "White-label production e-commerce and growth platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:start": "node deploy/scripts/local-db.js start",
    "db:stop": "node deploy/scripts/local-db.js stop",
    "db:status": "node deploy/scripts/local-db.js status",
    "redis:start": "node deploy/scripts/local-redis.js start",
    "redis:stop": "node deploy/scripts/local-redis.js stop",
    "redis:status": "node deploy/scripts/local-redis.js status",
    "db:migrate": "npm run db:migrate --workspace=@the-ecom-buddy/backend",
    "seed": "npm run seed --workspace=@the-ecom-buddy/backend",
    "verify": "npm run verify --workspace=@the-ecom-buddy/backend",
    "setup:02c": "npm run setup:02c --workspace=@the-ecom-buddy/backend",
    "verify:02c": "npm run verify:02c --workspace=@the-ecom-buddy/backend",
    "setup:02d-a": "npm run setup:02d-a --workspace=@the-ecom-buddy/backend",
    "verify:02d-a": "npm run verify:02d-a --workspace=@the-ecom-buddy/backend",
    "setup:02d-b": "npm run setup:02d-b --workspace=@the-ecom-buddy/backend",
    "verify:02d-b": "npm run verify:02d-b --workspace=@the-ecom-buddy/backend",
    "verify:03a": "npm run verify:03a --workspace=@the-ecom-buddy/merchant",
    "verify:03b": "npm run verify:03b --workspace=@the-ecom-buddy/merchant",
    "verify:03c": "npm run verify:03c --workspace=@the-ecom-buddy/merchant",
    "verify:03d": "npm run verify:03d --workspace=@the-ecom-buddy/merchant",
    "verify:03e": "npm run verify:03e --workspace=@the-ecom-buddy/merchant",
    "verify:04a": "npm run verify:04a --workspace=@the-ecom-buddy/storefront",
    "verify:04a-1": "npm run verify:04a-1 --workspace=@the-ecom-buddy/storefront",
    "verify:04b": "npm run verify:04b --workspace=@the-ecom-buddy/storefront",
    "verify:04c": "npm run verify:04c --workspace=@the-ecom-buddy/storefront",
    "dev:backend": "npm run dev --workspace=@the-ecom-buddy/backend",
    "dev:storefront": "npm run dev --workspace=@the-ecom-buddy/storefront",
    "dev:merchant": "npm run dev --workspace=@the-ecom-buddy/merchant",
    "build:backend": "npm run build --workspace=@the-ecom-buddy/backend",
    "build:storefront": "npm run build --workspace=@the-ecom-buddy/storefront",
    "build:merchant": "npm run build --workspace=@the-ecom-buddy/merchant",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "redis-memory-server": "^0.17.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "author": "The Ecom Buddy",
  "license": "UNLICENSED"
}
