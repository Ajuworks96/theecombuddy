{
  "name": "the-ecom-buddy",
  "version": "1.0.0",
  "private": true,
  "description": "White-label production e-commerce and growth platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:start": "node deploy/scripts/local-db.js start",
    "db:stop": "node deploy/scripts/local-db.js stop",
    "db:status": "node deploy/scripts/local-db.js status",
    "db:migrate": "npm run db:migrate --workspace=@the-ecom-buddy/backend",
    "dev:backend": "npm run dev --workspace=@the-ecom-buddy/backend",
    "dev:storefront": "npm run dev --workspace=@the-ecom-buddy/storefront",
    "build:backend": "npm run build --workspace=@the-ecom-buddy/backend",
    "build:storefront": "npm run build --workspace=@the-ecom-buddy/storefront",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "author": "The Ecom Buddy",
  "license": "UNLICENSED"
}
